# Copy to .env. Everything is optional: with no key the system runs fully deterministically.
# NOTE: in LLM mode, code snippets from the scanned repo are sent to the provider (secrets are redacted first).

# auto | gemini | openai | none   (auto prefers Gemini when GEMINI_API_KEY is set)
SCG_LLM_PROVIDER=auto
GEMINI_API_KEY=
# SCG_GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# SCG_OPENAI_MODEL=gpt-4.1-mini

# Max findings per scan that get an LLM pass (CRITICAL/HIGH only); the rest are deterministic.
SCG_MAX_LLM_FINDINGS=6

# 1 = no network at all (built-in demo advisories, name-only admission checks)
SCG_OFFLINE=0

# Optional allow-list of repo roots the API may scan (os.pathsep-separated)
# SCG_ALLOWED_ROOTS=C:\Users\me\repos
# SCG_DEFAULT_REPO=/tmp/juice-shop

# osv-scanner binary (default: osv-scanner on PATH) and offline use of its local database with SCG_OFFLINE=1
# SCG_OSV_SCANNER=/usr/local/bin/osv-scanner
# SCG_OSV_OFFLINE_DB=0

# Risk engine inputs
# NVD_API_KEY=            # optional: more CVSS fallback lookups per scan
# SCG_EXPOSURE=auto       # auto | internet | internal (deployment context override)
